# =============================================================================
# midscene-ai-e2e-suite 环境变量模板
# 复制本文件为 .env 后填入真实值。.env 已被 .gitignore 忽略，切勿提交到 Git。
# =============================================================================

# ---------- 多模态 VL 视觉模型配置（必填） ----------
# 注意：本 Demo 必须使用多模态视觉模型（Vision-Language Model），纯文本大模型无法运行。
# 支持的模型家族示例（按需任选其一）：
#   - 豆包 Seed：  MIDSCENE_MODEL_NAME=doubao-seed-1-6-251015   MIDSCENE_MODEL_FAMILY=doubao-seed
#   - 通义千问 VL：MIDSCENE_MODEL_NAME=qwen-vl-max            MIDSCENE_MODEL_FAMILY=qwen3
#   - DeepSeek VL：MIDSCENE_MODEL_NAME=deepseek-v4-flash-vision-exp MIDSCENE_MODEL_FAMILY=deepseek
#   - Gemini：     MIDSCENE_MODEL_NAME=gemini-2.x               MIDSCENE_MODEL_FAMILY=gemini
#   - GPT-5：     MIDSCENE_MODEL_NAME=gpt-5                     MIDSCENE_MODEL_FAMILY=gpt-5

# 模型服务 Base URL（OpenAI 兼容接口，通常以 /v1 结尾）
MIDSCENE_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型 API Key（请勿硬编码到源码或提交到 Git）
MIDSCENE_MODEL_API_KEY=replace-with-your-api-key

# 多模态视觉模型名称
MIDSCENE_MODEL_NAME=replace-with-your-model-name

# 模型家族（决定 Midscene 内部的解析/规划策略，必须与所选模型匹配）
MIDSCENE_MODEL_FAMILY=doubao-seed

# ---------- Midscene 运行产物目录（可选） ----------
# 设置后，Midscene 内置报告将输出到 ./output/report，缓存输出到 ./output/cache
# 默认即为 ./output，无需修改
MIDSCENE_RUN_DIR=./output
